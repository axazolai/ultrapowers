{
  "describesTree": "da1e7bb99212a060f90ffd6def69ff606775a79c",
  "describesTag": "upstream/6.2.0",
  "pluginRoot": "plugins/ultrapowers",
  "$doc": [
    "The plugin map. 'rules' classify an upstream path; 'manifest' records the class every",
    "known upstream path actually resolved to. Rules propose, the manifest confirms: a path",
    "present upstream but absent from the manifest is NEW and /up-update refuses until a human",
    "puts it in one of the two buckets. That is the whole point of keeping both.",
    "First matching rule wins, so order is load-bearing."
  ],
  "rules": [
    {
      "match": ".claude-plugin/plugin.json",
      "class": "tracked",
      "reason": "the Claude Code plugin manifest - the one file that makes this a plugin at all"
    },
    {
      "match": ".claude-plugin/marketplace.json",
      "class": "ignored",
      "reason": "upstream's own dev marketplace, source './' and owned by Jesse Vincent; our fork serves a marketplace of its own from the repo root, so shipping this one would misattribute a manifest we do not use"
    },
    {
      "match": "hooks/hooks.json",
      "class": "tracked",
      "reason": "SessionStart wiring - this is what injects using-superpowers at session start"
    },
    {
      "match": "hooks/session-start",
      "class": "tracked",
      "reason": "the SessionStart hook body"
    },
    {
      "match": "hooks/run-hook.cmd",
      "class": "tracked",
      "reason": "polyglot cmd/bash wrapper hooks.json invokes; required on Windows"
    },
    {
      "match": "hooks/hooks-cursor.json",
      "class": "ignored",
      "reason": "Cursor harness wiring - not Claude Code"
    },
    {
      "match": "skills/using-superpowers/references/**",
      "class": "ignored",
      "reason": "per-harness adaptation notes for Codex/Pi/Gemini/Antigravity; this fork targets Claude Code only, and delta 002 removes the Platform Adaptation section that links them so no reference is left dangling"
    },
    {
      "match": "skills/**",
      "class": "tracked",
      "reason": "the skills library - the substance of the plugin"
    },
    {
      "match": "LICENSE",
      "class": "tracked",
      "mode": "verbatim",
      "alsoAtRoot": true,
      "reason": "MIT obligation: the upstream copyright notice must survive redistribution byte-for-byte, so it is never passed through the rename"
    },
    {
      "match": "README.md",
      "class": "ignored",
      "reason": "replaced by a fork-owned README: every obra/superpowers occurrence upstream is an install instruction for upstream's own distribution channels, so renaming or protecting it both produce a README that installs the wrong plugin. Attribution lives in our README by construction"
    },
    {
      "match": ".agents/**",
      "class": "ignored",
      "reason": "other harness (agents.md convention)"
    },
    {
      "match": ".codex-plugin/**",
      "class": "ignored",
      "reason": "other harness (Codex)"
    },
    {
      "match": ".cursor-plugin/**",
      "class": "ignored",
      "reason": "other harness (Cursor)"
    },
    {
      "match": ".kimi-plugin/**",
      "class": "ignored",
      "reason": "other harness (Kimi)"
    },
    {
      "match": ".opencode/**",
      "class": "ignored",
      "reason": "other harness (opencode)"
    },
    {
      "match": ".pi/**",
      "class": "ignored",
      "reason": "other harness (Pi)"
    },
    {
      "match": "gemini-extension.json",
      "class": "ignored",
      "reason": "other harness (Gemini extension manifest)"
    },
    {
      "match": "assets/**",
      "class": "ignored",
      "reason": "app icon and logo, referenced only by .codex-plugin/plugin.json; they leave with the harness that used them"
    },
    {
      "match": "tests/**",
      "class": "ignored",
      "reason": "upstream's own harness test suite - shell/python drivers for Codex, Kimi, opencode and Claude Code eval runs; not plugin content and not runnable as part of this fork"
    },
    {
      "match": "docs/**",
      "class": "ignored",
      "reason": "upstream's plans and specs - their development record, not ours"
    },
    {
      "match": ".github/**",
      "class": "ignored",
      "reason": "upstream CI, funding and issue templates"
    },
    {
      "match": "scripts/**",
      "class": "ignored",
      "reason": "upstream release tooling (version bump, codex packaging, shell lint); the fork releases through /up-update instead"
    },
    {
      "match": "package.json",
      "class": "ignored",
      "reason": "npm/pi packaging for upstream's multi-harness distribution; delta 003 repoints the one runtime reader of it (brainstorming server.cjs) at .claude-plugin/plugin.json"
    },
    {
      "match": ".version-bump.json",
      "class": "ignored",
      "reason": "config for upstream's scripts/bump-version.sh, which we do not ship"
    },
    {
      "match": ".pre-commit-config.yaml",
      "class": "ignored",
      "reason": "upstream repo tooling"
    },
    {
      "match": ".gitattributes",
      "class": "ignored",
      "reason": "upstream repo tooling; the fork owns its own, because the built tree's line endings are our concern not theirs"
    },
    {
      "match": ".gitignore",
      "class": "ignored",
      "reason": "upstream repo tooling"
    },
    {
      "match": "AGENTS.md",
      "class": "ignored",
      "reason": "contributor instructions for upstream's repository (a symlink to CLAUDE.md), not plugin content"
    },
    {
      "match": "CLAUDE.md",
      "class": "ignored",
      "reason": "contributor instructions for upstream's repository, not plugin content"
    },
    {
      "match": "GEMINI.md",
      "class": "ignored",
      "reason": "contributor instructions for upstream's repository, not plugin content"
    },
    {
      "match": "CODE_OF_CONDUCT.md",
      "class": "ignored",
      "reason": "governance of upstream's project, which the fork does not administer"
    },
    {
      "match": "RELEASE-NOTES.md",
      "class": "ignored",
      "reason": "upstream's changelog; /up-update prints its diff on an upstream bump instead of shipping it"
    }
  ],
  "forkOwned": [
    {
      "src": "fork-owned/marketplace.json",
      "dest": ".claude-plugin/marketplace.json",
      "reason": "the fork is its own marketplace, so a fresh machine needs only `/plugin marketplace add axazolai/ultrapowers` with no git authentication"
    },
    {
      "src": "fork-owned/gitattributes",
      "dest": ".gitattributes",
      "reason": "keeps the generated tree's line endings LF on Windows checkouts; a CRLF checkout would make the byte-for-byte rebuild check fail for reasons that have nothing to do with the build"
    },
    {
      "src": "fork-owned/README.plugin.md",
      "dest": "plugins/ultrapowers/README.md",
      "reason": "the plugin README: install instructions point at this fork, and MIT attribution to obra/superpowers and Jesse Vincent lives here by construction rather than by freezing upstream strings"
    },
    {
      "src": "fork-owned/README.repo.md",
      "dest": "README.md",
      "reason": "repository-level README: what this repo is, how the three branches relate, and how to rebuild"
    },
    {
      "src": "fork-owned/phase-dir",
      "dest": "plugins/ultrapowers/skills/brainstorming/scripts/phase-dir",
      "mode": "100755",
      "reason": "one allocator for .ultrapowers/{phases,tasks,adhoc}/NN-slug/, so brainstorming, writing-plans and subagent-driven-development cannot disagree about which directory a phase's documents belong to"
    },
    {
      "src": "fork-owned/summary-writer-prompt.md",
      "dest": "plugins/ultrapowers/skills/subagent-driven-development/summary-writer-prompt.md",
      "reason": "the SUMMARY is a fold of the ledger plus every implementer report - tens of thousands of tokens the controller must not read itself, so the fold is delegated and only a path comes back"
    },
    {
      "src": "fork-owned/verification-prompt.md",
      "dest": "plugins/ultrapowers/skills/subagent-driven-development/verification-prompt.md",
      "reason": "goal-backward verification reads the whole branch diff and decides little - bulk reading that belongs in a subagent, returning a verdict and a path"
    }
  ],
